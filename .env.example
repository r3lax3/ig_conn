# Connector configuration. Copy to .env and fill in; values come from the bus access kit (contract section 2).
CHANNEL_TYPE=

KAFKA_BOOTSTRAP_SERVERS=
# <channel_type>-connector with dashes instead of underscores
KAFKA_USERNAME=
KAFKA_PASSWORD=

S3_ENDPOINT=
S3_REGION=crm-bus
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# docker compose: leave DATABASE_URL empty and set POSTGRES_PASSWORD (hex, no URL special characters),
# compose then points the connector at its own Postgres. Without compose: postgresql://user:password@host:5432/db
DATABASE_URL=
POSTGRES_PASSWORD=
# Fernet key that encrypts Sessions at rest; generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
# Accounts talking to Instagram at the same time (commands, inbox polls, restores)
MAX_PARALLEL_SOURCES=20
# Seconds between inbox polls of each account (at least 5): the delay of inbound messages
INBOUND_POLL_INTERVAL=30

# Proxies (one of the two). The proxy service: its base URL and this client's x-proxy-token
PROXY_SERVICE_URL=
PROXY_SERVICE_TOKEN=
# Or one proxy for every account, scheme://user:password@host:port
# STATIC_PROXY_URL=

# DEBUG / INFO / WARNING / ERROR; JSON lines on stdout
LOG_LEVEL=INFO
# Touched while the service is healthy; `ig-connector health` checks its age
# HEALTH_FILE=/tmp/ig-connector.health

# fake-crm only: a principal allowed to write to the commands topic (test stand only)
FAKE_CRM_KAFKA_USERNAME=
FAKE_CRM_KAFKA_PASSWORD=
